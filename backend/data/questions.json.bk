  "q-e1b20b2c": {
    "id": "q-e1b20b2c",
    "title": "北京市丰台区 2024~2025 学年度第二学期综合练习（一）",
    "year": 2025,
    "section": "",
    "subsection": "",
    "questionNumber": "语法填空A",
    "articleContent": "Whales swim by moving their tails up and down. This motion \\clozeblank{11} (create) pressure pulses(脉冲) which harm their brains. However, whales find a way \\clozeblank{12} (avoid) such damage. Research has revealed that a network of blood vessels(血管) in their brains plays a crucial role. It can maintain stable blood pressure, \\clozeblank{13} (effective) reducing over 90% of the potential harm. This discovery also helps explain \\clozeblank{14} seals, which don't face the same issue, lack these structures.",
    "questionContent": "",
    "labels": [
      "科普",
      "动物",
      "生物"
    ],
    "answers": [],
    "subQuestionCount": 0,
    "createdAt": 1767931118248,
    "updatedAt": 1767931118248,
