  "q-18577389": {
    "id": "q-18577389",
    "title": "北京市朝阳区高三年级第二学期质量检测一",
    "year": 2025,
    "section": "",
    "subsection": "",
    "questionNumber": "语法填空B",
    "articleContent": "DeepSeek-R1, \\clozeblank{14} core technologies are built upon next-generation large language model architecture, highlights China’s growing strength in AI innovation. This smart assistant can answer complex questions, create digital art and even write computer code. DeepSeek-R1 learns by repeatedly \\clozeblank{15} (try), unlike other AIs that rely on large amounts of prepared examples. It practises many times and gets \\clozeblank{16} (good), much like how students master maths. \\clozeblank{17} the development of DeepSeek-R1, China shows the world that great things come from new ideas and hard work, not just money.",
    "questionContent": "",
    "labels": [
      "人工智能",
      "科技",
      "创新"
