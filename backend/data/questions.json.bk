  "q-55dc5129": {
    "id": "q-55dc5129",
    "title": "北京市朝阳区高三年级第二学期质量检测一",
    "year": 2025,
    "section": "",
    "subsection": "",
    "questionNumber": "语法填空C",
    "articleContent": "It’s difficult \\clozeblank{18} (understand) jargon-filled (充满行话的) writing that academics have long been accused of. To track academic writing over time, The Economist analysed 347,000 PhD abstracts \\clozeblank{19} (publish) between 1812 and 2023. They found that the abstracts have become harder to read. Though specialization and advances in technology require more precise terms, the trend of unreadable academic writing \\clozeblank{20} (grow) stronger. Clear and simple writing would be a breath of fresh air.",
    "questionContent": "",
    "labels": [
      "学术写作",
      "语言",
      "趋势"
    ],
    "answers": [],
    "subQuestionCount": 0,
    "createdAt": 1767929683764,
